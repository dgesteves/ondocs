{
  "$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "dgesteves/ondocs"
    }
  ],
  "commit": false,
  "access": "public",
  "baseBranch": "main",
  "fixed": [["ondocs", "docusaurus-plugin-ondocs", "starlight-ondocs"]],
  "linked": [],
  "updateInternalDependencies": "patch",
  "privatePackages": {
    "version": true,
    "tag": false
  },
  "ignore": [
    "ondocs-example-docusaurus",
    "ondocs-example-nextjs",
    "ondocs-example-starlight",
    "ondocs-example-vitepress"
  ],
  "changedFilePatterns": ["src/**", "package.json", "README.md"]
}
