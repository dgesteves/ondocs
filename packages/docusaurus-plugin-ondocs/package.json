{
  "name": "docusaurus-plugin-ondocs",
  "version": "0.15.0",
  "description": "The ondocs Docusaurus plugin, under the name Docusaurus users search for: open-source Ask AI for your docs, with an MCP server for agents. Cited answers on your own model key, from one static index, with no vendor and no vector database.",
  "keywords": [
    "docusaurus",
    "docusaurus-plugin",
    "docusaurus-theme",
    "ask-ai",
    "ai-search",
    "docs-search",
    "search",
    "mcp",
    "mcp-server",
    "llms-txt",
    "rag",
    "ai"
  ],
  "homepage": "https://ondocs.vercel.app/docs/docusaurus",
  "bugs": "https://github.com/dgesteves/ondocs/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgesteves/ondocs.git",
    "directory": "packages/docusaurus-plugin-ondocs"
  },
  "license": "MIT",
  "author": "Diogo Esteves (https://github.com/dgesteves)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "dependencies": {
    "ondocs": "workspace:*"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.0.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "cmdk": "^1.1.1",
    "ai": "^7.0.95",
    "@ai-sdk/openai": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
