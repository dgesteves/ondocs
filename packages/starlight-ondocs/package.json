{
  "name": "starlight-ondocs",
  "version": "0.17.0",
  "description": "The ondocs Starlight plugin, under the name Starlight users search for: open-source Ask AI for your docs, with an MCP server for agents. Cited answers on your own model key, from one static index, with no vendor and no vector database.",
  "keywords": [
    "starlight",
    "starlight-plugin",
    "withastro",
    "astro-integration",
    "astro",
    "ask-ai",
    "ai-search",
    "docs-search",
    "search",
    "mcp",
    "mcp-server",
    "llms-txt",
    "rag",
    "ai",
    "ui",
    "utility"
  ],
  "homepage": "https://ondocs.vercel.app/docs/astro",
  "bugs": "https://github.com/dgesteves/ondocs/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgesteves/ondocs.git",
    "directory": "packages/starlight-ondocs"
  },
  "license": "MIT",
  "author": "Diogo Esteves (https://github.com/dgesteves)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "dependencies": {
    "ondocs": "workspace:*"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.32.0 <1",
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "ai": "^6.0.16 || ^7.0.95",
    "@ai-sdk/openai": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
